<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HddSanitizer.App.EraseProgressWindow"
        Title="Löschvorgang läuft..."
        Width="450" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="BorderOnly">

    <StackPanel Margin="25" Spacing="15" VerticalAlignment="Center">
        <TextBlock x:Name="TxtStatus" Text="Löschvorgang wird gestartet..." FontSize="14" FontWeight="Bold"/>
        
        <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" Height="20" HorizontalAlignment="Stretch"/>

        <TextBlock x:Name="TxtDetail" Text="Bitte das Laufwerk während des Vorgangs nicht trennen." Foreground="Gray" FontSize="12"/>
    </StackPanel>
</Window>
