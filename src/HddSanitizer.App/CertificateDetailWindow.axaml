<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HddSanitizer.App.CertificateDetailWindow"
        x:CompileBindings="False"
        Title="Zertifikat Details"
        Width="500" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="📄 Zertifikat Details" FontSize="18" FontWeight="Bold"/>

        <Border Background="#1E1E1E" Padding="15" CornerRadius="5">
            <StackPanel Spacing="6">
                <TextBlock x:Name="TxtCertId" FontWeight="Bold" Foreground="LightBlue"/>
                <TextBlock x:Name="TxtModel"/>
                <TextBlock x:Name="TxtSerial" Foreground="Yellow"/>
                <TextBlock x:Name="TxtCapacity"/>
                <TextBlock x:Name="TxtMethod"/>
                <TextBlock x:Name="TxtDate" Foreground="Gray" FontSize="11"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="TxtExportStatus" Foreground="LightGreen" FontSize="12" IsVisible="False"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
            <Button Content=" picture_as_pdf PDF Exportieren" Click="OnExportPdfClick" Background="DarkRed" Foreground="White"/>
            <Button Content="Schließen" Click="OnCloseClick"/>
        </StackPanel>
    </StackPanel>
</Window>
