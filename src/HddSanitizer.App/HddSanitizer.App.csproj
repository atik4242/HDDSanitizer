<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Anwendungs-Icon für Windows & Taskleiste -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.0.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.0.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.10" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.0.10" />
    <!-- Condition for diagnostics because Avalonia.Diagnostics should not be included in release builds. -->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HddSanitizer.Core\HddSanitizer.Core.csproj" />
    <ProjectReference Include="..\HddSanitizer.Domain\HddSanitizer.Domain.csproj" />
    <ProjectReference Include="..\HddSanitizer.Infrastructure\HddSanitizer.Infrastructure.csproj" />
    <ProjectReference Include="..\HddSanitizer.SeaChest\HddSanitizer.SeaChest.csproj" />
  </ItemGroup>

  <!-- Damit app.ico mit ins Ausgabe-Verzeichnis kopiert wird -->
  <ItemGroup>
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
