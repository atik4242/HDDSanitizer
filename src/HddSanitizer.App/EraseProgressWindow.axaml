<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HddSanitizer.App.EraseProgressWindow"
        Title="Löschvorgang läuft..."
        Width="650" Height="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        SystemDecorations="BorderOnly">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,10">
            <TextBlock x:Name="TxtStatus" Text="Löschvorgang wird gestartet..." FontSize="14" FontWeight="Bold"/>
            <TextBlock x:Name="TxtDetail" Text="Bitte das Laufwerk während des Vorgangs nicht trennen." Foreground="Gray" FontSize="12"/>
        </StackPanel>
        
        <ProgressBar Grid.Row="1" x:Name="ProgressBar" IsIndeterminate="True" Height="15" HorizontalAlignment="Stretch" Margin="0,0,0,15"/>

        <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="5" Padding="10">
            <ScrollViewer x:Name="LogScrollViewer">
                <TextBlock x:Name="TxtLiveLog" FontFamily="Consolas, Courier New, Monospace" 
                           FontSize="11" Foreground="#00FF00" TextWrapping="Wrap" Text="Warte auf CLI-Rückmeldung..."/>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" Text="Hinweis: openSeaChest sendet Fortschritts-Updates direkt in dieses Fenster." Foreground="Gray" FontSize="10" Margin="0,10,0,0"/>
    </Grid>
</Window>
