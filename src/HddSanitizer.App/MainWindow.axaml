<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
        x:Class="HddSanitizer.App.MainWindow"
        x:CompileBindings="False"
        Title="HDD Sanitizer - Enterprise Erasure Suite"
        Width="950" Height="600"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto, *, Auto" Margin="20">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,20">
            <TextBlock Text="🪓 HDD Sanitizer Dashboard" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Erkannte Laufwerke &amp; Sanitization Management" Foreground="Gray"/>
        </StackPanel>

        <!-- Laufwerks-Tabelle -->
        <DataGrid Grid.Row="1" x:Name="GridDrives" ItemsSource="{Binding Drives}" AutoGenerateColumns="False"
                  IsReadOnly="True" GridLinesVisibility="All" BorderThickness="1" BorderBrush="#333333"
                  SelectionChanged="OnDriveSelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Pfad" Binding="{Binding DevicePath}" Width="80"/>
                <DataGridTextColumn Header="Modell" Binding="{Binding ModelName}" Width="250"/>
                <DataGridTextColumn Header="Seriennummer" Binding="{Binding SerialNumber}" Width="160"/>
                <DataGridTextColumn Header="Kapazität (TB)" Binding="{Binding CapacityTB}" Width="120"/>
                <DataGridTextColumn Header="Schnittstelle" Binding="{Binding InterfaceType}" Width="100"/>
                <DataGridCheckBoxColumn Header="System-Platte (Gesperrt)" Binding="{Binding IsSystemDrive}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer / Statusbar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
            <Button Content="🔄 Liste aktualisieren" Click="OnRefreshClick"/>
            <Button x:Name="BtnErase" Content="🛡️ Ausgewähltes Laufwerk Löschen" IsEnabled="False" Click="OnEraseClick"/>
        </StackPanel>
    </Grid>
</Window>
