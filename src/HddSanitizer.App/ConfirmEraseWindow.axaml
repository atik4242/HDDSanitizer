<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HddSanitizer.App.ConfirmEraseWindow"
        Title="⚠️ WARNUNG: Löschvorgang bestätigen"
        Width="520" Height="380"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="⚠️ ACHTUNG: LÖSCHVORGANG IST UNUMKEHRBAR!" FontSize="16" FontWeight="Bold" Foreground="Red"/>
        
        <TextBlock TextWrapping="Wrap">
            Sie sind dabei, sämtliche Daten auf folgendem Laufwerk dauerhaft zu vernichten:
        </TextBlock>

		<Border Background="#F4F5F7" BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" CornerRadius="8">
			<StackPanel Spacing="3">
				<TextBlock x:Name="TxtModel" FontWeight="Bold" Foreground="#333333"/>
				<TextBlock x:Name="TxtPath" Foreground="#666666"/>
				<TextBlock x:Name="TxtSerial" Foreground="#D32F2F" FontWeight="Bold"/>
			</StackPanel>
        </Border>

        <StackPanel Spacing="4">
            <TextBlock Text="Löschmethode auswählen:" FontSize="12" FontWeight="SemiBold"/>
            <ComboBox x:Name="ComboMethod" HorizontalAlignment="Stretch" SelectedIndex="0">
                <ComboBoxItem>NIST 800-88 Clear (Zero-Fill Overwrite)</ComboBoxItem>
                <ComboBoxItem>Hardware Native Sanitize / Secure Erase</ComboBoxItem>
                <ComboBoxItem>Random Pattern Overwrite (1-Pass)</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <TextBlock Text="Bitte geben Sie zur Bestätigung die Seriennummer exakt ein:" FontSize="12"/>
        <TextBox x:Name="InputSerial" Watermark="Seriennummer hier eingeben..."/>

        <TextBlock x:Name="TxtError" Foreground="Red" FontSize="12" IsVisible="False"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Abbrechen" Click="OnCancelClick"/>
            <Button Content="🔥 Endgültig Löschen" Click="OnConfirmClick" Background="DarkRed" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>
